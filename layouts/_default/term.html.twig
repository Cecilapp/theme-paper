{% extends '_default/list.html.twig' %}

{% block content %}
      <h1 class="text-2xl font-semibold sm:text-3xl">{% trans %}Tag{% endtrans %}: {{ page.title }}</h1>
      <p class="mt-2 mb-6 italic">{% trans with {'%tag%': page.title} %}All the articles with the tag "%tag%".{% endtrans %}</p>
      <ul>
        {%- for post in pages %}
        {{ include('partials/paper/card.html.twig', {post}, with_context = false) }}
        {%- endfor %}
      </ul>
{%- endblock content %}