{% extends ['page.html.twig', '_default/page.html.twig'] %}

{% block content %}
      <h1 class="text-2xl font-semibold sm:text-3xl">{{ page.title|trans }}</h1>
      <p class="mt-2 mb-6 italic">{{ page.description|default('All the tags used in posts.'|trans) }}</p>
      <ul class="flex flex-wrap gap-6">
        {%- for term in page.terms %}
        {{ include('partials/paper/tag.html.twig', {term: term.name, url: url(term.id, {language: site.language})}, with_context = false) }}
        {%- endfor %}
      </ul>
{%- endblock content %}