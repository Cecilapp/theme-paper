{#- Callout (Markdown note `:::<type>`), with a title: `note` variable only ~#}
{%- set titles = {
  note: 'Note'|trans,
  info: 'Info'|trans,
  tip: 'Tip'|trans,
  success: 'Success'|trans,
  important: 'Important'|trans,
  warning: 'Warning'|trans,
  caution: 'Caution'|trans,
  danger: 'Danger'|trans,
  error: 'Error'|trans
} -%}
{%- set icons = {
  note: '<path d="M3 20h4l10.5 -10.5a2.828 2.828 0 1 0 -4 -4l-10.5 10.5v4"/><path d="M13.5 6.5l4 4"/>',
  info: '<path d="M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0"/><path d="M12 9h.01"/><path d="M11 12h1v4h1"/>',
  tip: '<path d="M3 12h1m8 -9v1m8 8h1m-15.4 -6.4l.7 .7m12.1 -.7l-.7 .7"/><path d="M9 16a5 5 0 1 1 6 0a3.5 3.5 0 0 0 -1 3a2 2 0 0 1 -4 0a3.5 3.5 0 0 0 -1 -3"/><path d="M9.7 17l4.6 0"/>',
  success: '<path d="M5 12l5 5l10 -10"/>',
  important: '<path d="M8 9h8"/><path d="M8 13h6"/><path d="M12.01 18.594l-4.01 2.406v-3h-2a3 3 0 0 1 -3 -3v-8a3 3 0 0 1 3 -3h12a3 3 0 0 1 3 3v5.5"/><path d="M19 16v3"/><path d="M19 22v.01"/>',
  warning: '<path d="M12 9v4"/><path d="M10.363 3.591l-8.106 13.534a1.914 1.914 0 0 0 1.636 2.871h16.214a1.914 1.914 0 0 0 1.636 -2.87l-8.106 -13.536a1.914 1.914 0 0 0 -3.274 0z"/><path d="M12 16h.01"/>',
  caution: '<path d="M12 8v4"/><path d="M12 16h.01"/><path d="M8.7 3h6.6c.3 0 .5 .1 .7 .3l4.7 4.7c.2 .2 .3 .4 .3 .7v6.6c0 .3 -.1 .5 -.3 .7l-4.7 4.7c-.2 .2 -.4 .3 -.7 .3h-6.6c-.3 0 -.5 -.1 -.7 -.3l-4.7 -4.7c-.2 -.2 -.3 -.4 -.3 -.7v-6.6c0 -.3 .1 -.5 .3 -.7l4.7 -4.7c.2 -.2 .4 -.3 .7 -.3z"/>'
} -%}
{%- set icon = icons[note.type] ?? (note.type in ['danger', 'error'] ? icons.caution : icons.note) -%}
<aside class="note note-{{ note.type|e }}" id="{{ note.id|e }}">
  <p class="note-title"><svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">{{ icon|raw }}</svg>{{ titles[note.type] ?? note.type|capitalize }}</p>
  {{ note.content|raw }}
</aside>